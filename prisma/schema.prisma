generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String?
  passwordHash      String?
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  connectedAccounts ConnectedAccount[]
  emailMessages     EmailMessage[]
  connectedCalendars ConnectedCalendar[]
  calendarEvents     CalendarEvent[]
}

model ConnectedAccount {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]
  connectedCalendars ConnectedCalendar[]
  calendarEvents     CalendarEvent[]

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum AICategory {
  WORK
  COLLEGE
  PLACEMENT
  PERSONAL
  FINANCE
  SOCIAL
  PROMOTION
  NEWSLETTER
  SECURITY
  TRANSACTION
  OTHER
}

enum AIPriority {
  HIGH
  MEDIUM
  LOW
}

model EmailMessage {
  id                 String   @id @default(uuid())
  userId             String
  connectedAccountId String

  gmailMessageId     String
  threadId           String?

  sender             String?
  recipients         String?
  subject            String?
  snippet            String?

  bodyText           String?

  receivedAt         DateTime?

  isRead             Boolean  @default(false)

  labels             String?

  // AI Intelligence fields (Milestone 3.2)
  aiCategory         AICategory?
  aiPriority         AIPriority?
  aiActionable       Boolean?
  aiSummary          String?
  aiReason           String?
  aiProcessedAt      DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId])
  @@index([connectedAccountId])
  @@index([receivedAt])
  @@index([userId, aiProcessedAt])
}

model ConnectedCalendar {
  id                 String           @id @default(uuid())
  userId             String
  connectedAccountId String
  googleCalendarId   String
  summary            String
  description        String?          @db.Text
  timeZone           String?
  isPrimary          Boolean          @default(false)
  isSelected         Boolean          @default(false)
  accessRole         String?
  syncToken          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  calendarEvents   CalendarEvent[]

  @@unique([connectedAccountId, googleCalendarId])
  @@index([userId])
  @@index([connectedAccountId])
}

model CalendarEvent {
  id                 String   @id @default(uuid())
  userId             String
  connectedAccountId String
  calendarId         String
  googleEventId      String

  title              String
  description        String?  @db.Text
  location           String?
  startTime          DateTime
  endTime            DateTime
  isAllDay           Boolean  @default(false)
  timeZone           String?
  status             String?  // confirmed, tentative, cancelled
  htmlLink           String?
  organizer          String?
  attendees          String?  // JSON stringified list of attendees

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  calendar         ConnectedCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, googleEventId])
  @@index([userId])
  @@index([connectedAccountId])
  @@index([calendarId])
  @@index([startTime, endTime])
}


