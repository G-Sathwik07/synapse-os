generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(uuid())
  email                      String                      @unique
  name                       String?
  passwordHash               String?
  image                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  connectedAccounts          ConnectedAccount[]
  emailMessages              EmailMessage[]
  connectedCalendars         ConnectedCalendar[]
  calendarEvents             CalendarEvent[]
  communicationConversations CommunicationConversation[]
  communicationMessages      CommunicationMessage[]
}

model ConnectedAccount {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  status            String?   @default("CONNECTED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessages              EmailMessage[]
  connectedCalendars         ConnectedCalendar[]
  calendarEvents             CalendarEvent[]
  whatsappSession            WhatsAppSession?
  communicationConversations CommunicationConversation[]
  communicationMessages      CommunicationMessage[]

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum AICategory {
  WORK
  COLLEGE
  PLACEMENT
  PERSONAL
  FINANCE
  SOCIAL
  PROMOTION
  NEWSLETTER
  SECURITY
  TRANSACTION
  OTHER
}

enum AIPriority {
  HIGH
  MEDIUM
  LOW
}

model EmailMessage {
  id                 String @id @default(uuid())
  userId             String
  connectedAccountId String

  gmailMessageId String
  threadId       String?

  sender     String?
  recipients String?
  subject    String?
  snippet    String?

  bodyText String?

  receivedAt DateTime?

  isRead Boolean @default(false)

  labels String?

  // AI Intelligence fields (Milestone 3.2)
  aiCategory    AICategory?
  aiPriority    AIPriority?
  aiActionable  Boolean?
  aiSummary     String?
  aiReason      String?
  aiProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId])
  @@index([connectedAccountId])
  @@index([receivedAt])
  @@index([userId, aiProcessedAt])
}

model ConnectedCalendar {
  id                 String   @id @default(uuid())
  userId             String
  connectedAccountId String
  googleCalendarId   String
  summary            String
  description        String?  @db.Text
  timeZone           String?
  isPrimary          Boolean  @default(false)
  isSelected         Boolean  @default(false)
  accessRole         String?
  syncToken          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  calendarEvents   CalendarEvent[]

  @@unique([connectedAccountId, googleCalendarId])
  @@index([userId])
  @@index([connectedAccountId])
}

model CalendarEvent {
  id                 String @id @default(uuid())
  userId             String
  connectedAccountId String
  calendarId         String
  googleEventId      String

  title       String
  description String?  @db.Text
  location    String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean  @default(false)
  timeZone    String?
  status      String? // confirmed, tentative, cancelled
  htmlLink    String?
  organizer   String?
  attendees   String? // JSON stringified list of attendees

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  calendar         ConnectedCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, googleEventId])
  @@index([userId])
  @@index([connectedAccountId])
  @@index([calendarId])
  @@index([startTime, endTime])
}

model WhatsAppSession {
  id                 String   @id @default(uuid())
  connectedAccountId String   @unique
  creds              String   @db.Text
  keys               String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
}

model CommunicationConversation {
  id                   String   @id @default(uuid())
  userId               String
  connectedAccountId   String
  source               String // "whatsapp"
  remoteConversationId String // JID for WhatsApp
  title                String?
  avatar               String?
  isGroup              Boolean  @default(false)
  lastMessageAt        DateTime @default(now())
  lastMessagePreview   String?
  unreadCount          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount           @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  messages         CommunicationMessage[]
  participants     CommunicationParticipant[]

  @@unique([connectedAccountId, remoteConversationId])
  @@index([userId])
  @@index([connectedAccountId])
  @@index([lastMessageAt])
}

model CommunicationParticipant {
  id                  String   @id @default(uuid())
  conversationId      String
  remoteParticipantId String // JID / phone / external ID
  phone               String? // Normalized phone number
  displayName         String?
  avatar              String?
  role                String? // admin, member, etc.
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, remoteParticipantId])
  @@index([conversationId])
}

model CommunicationMessage {
  id                 String   @id @default(uuid())
  userId             String
  conversationId     String
  connectedAccountId String
  source             String // "whatsapp"
  remoteMessageId    String
  senderId           String
  senderName         String?
  text               String?
  messageType        String   @default("text") // "text", "image", "video", "audio", "document", etc.
  isFromMe           Boolean  @default(false)
  isRead             Boolean  @default(false)
  sentAt             DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // AI Intelligence fields (similar to EmailMessage)
  aiCategory    AICategory?
  aiPriority    AIPriority?
  aiActionable  Boolean?
  aiSummary     String?
  aiReason      String?
  aiProcessedAt DateTime?

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount          @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  conversation     CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, remoteMessageId])
  @@index([userId])
  @@index([conversationId])
  @@index([connectedAccountId])
  @@index([sentAt])
  @@index([userId, aiProcessedAt])
}
